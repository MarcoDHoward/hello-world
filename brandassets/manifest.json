    {
      "path": "tent-cards/revelry-room-tent-sheet.png",
      "type": "print",
      "series": "velvet",
      "width": 1200,
      "height": 3600,
      "dpi": 300,
      "use": "Table tent print sheet as an image."
    },
    {
      "path": "tent-cards/revelry-room-tent-face.png",
