  "missing": [
    "mirage-logo-stacked.svg",
    "mirage-logo-horizontal.svg",
    "mirage-mark.svg",
    "mirage-icon-neutral.svg",
    "mirage-icon-velvet.svg",
    "mirage-icon-nocturne.png",
    "mirage-icon-nocturne.svg"
  ],
  "flyerLayout": {
    "canvas": "1080x1350, 4:5 portrait",
    "header": "Three items on one top edge: date top-left (month in spaced Michroma caps over an Archivo Black two-digit numeral), venue centred (Michroma caps, time in Michroma beneath), logo lockup top-right (mark over MIRAGE wordmark).",
    "lineup": "Starts about 30% down, left-aligned at an 11% margin. Series name, headliner in Archivo Black caps, label credits in parentheses tucked tight beneath in spaced Michroma caps, a large gap, support pair in Archivo 300 caps, a gap, opener.",
    "footer": "Sound tags centred in spaced Michroma caps, joined with a middle dot.",
    "background": "Series bg with a subtle textured field. Velvet: amber shimmer column. Nocturne: navy light trails. Large empty fields above and below the lineup block."
  }
