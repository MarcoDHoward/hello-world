{
  "brand": "MIRAGE",
  "oneLiner": "Melodic techno and progressive house in Seattle.",
  "reference": "../brand.md",
  "designGuide": "../DESIGN.md",
  "copyGuide": "../COPY.md",
  "tokens": "tokens.css",
  "rules": [
    "Dark backgrounds only.",
    "One accent colour per piece.",
    "Michroma is a single weight. Never synthesize bold.",
    "Archivo Black for headliner names and the date numeral only.",
    "Cormorant Garamond italic for the Velvet series name and accents only.",
    "Few words. No hype, no exclamation points, no emoji."
  ],
  "series": {
    "velvet": {
      "name": "VELVET",
      "displayName": "Velvet",
      "tagline": "Come in closer.",
      "venue": "The Speakeasy",
      "hours": "9:00PM \u2013 1:00AM",
      "sound": "Trip hop into progressive",
      "soundTags": [
        "Trip hop",
        "Progressive"
      ],
      "seriesNameFont": "Cormorant Garamond italic",
      "palette": {
        "bg": "#0E070B",
        "deep": "#22101A",
        "wine": "#4A1A28",
        "rose": "#C98B7A",
        "amber": "#E3A45A",
        "cream": "#EDE3D6",
        "reflect": "#7A4C4A"
      },
      "accent": "#E3A45A",
      "text": "#EDE3D6"
    },
    "nocturne": {
      "name": "NOCTURNE",
      "displayName": "NOCTURNE",
      "tagline": "Into the night.",
      "venue": "Monkey Loft",
      "hours": "10:00PM \u2013 4:00AM",
      "sound": "Progressive into techno",
      "soundTags": [
        "Progressive",
        "Techno"
      ],
      "seriesNameFont": "Michroma",
      "palette": {
        "bg": "#05080E",
        "navy": "#15304A",
        "violet": "#6A5AE0",
        "cyan": "#4FD8DC",
        "ice": "#E4EAF0",
        "reflect": "#3E5B78"
      },
      "accent": "#4FD8DC",
      "text": "#E4EAF0"
    },
    "parent": {
      "name": "MIRAGE",
      "palette": {
        "bg": "#0A0D12",
        "text": "#E4EAF0",
        "bar": "#E4EAF0",
        "accent": "#9FB4C4",
        "reflect": "#6F8698"
      },
      "accent": "#9FB4C4",
      "text": "#E4EAF0"
    }
  },
  "fonts": [
    {
      "family": "Michroma",
      "weights": [
        400
      ],
      "use": "wordmark, nav, labels, times, Nocturne series name",
      "tracking": "0.28\u20130.40em on all caps"
    },
    {
      "family": "Archivo Black",
      "weights": [
        400
      ],
      "use": "headliner names, date numeral"
    },
    {
      "family": "Archivo",
      "weights": [
        300,
        400
      ],
      "use": "300 support acts and openers; 400 body, label credits"
    },
    {
      "family": "Cormorant Garamond",
      "weights": [
        400,
        500
      ],
      "style": "italic",
      "use": "Velvet series name and accents only"
    }
  ],
  "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@300;400&family=Cormorant+Garamond:ital,wght@1,400;1,500&family=Michroma&display=swap",
  "assets": [
