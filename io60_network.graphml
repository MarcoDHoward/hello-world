<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns
         http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">

  <!-- Node attributes -->
  <key id="name" for="node" attr.name="name" attr.type="string"/>
  <key id="markers" for="node" attr.name="markers" attr.type="string"/>
  <key id="cell_type" for="node" attr.name="cell_type" attr.type="string"/>
  <key id="lineage" for="node" attr.name="lineage" attr.type="string"/>
  <key id="color" for="node" attr.name="color" attr.type="string"/>
  <key id="size" for="node" attr.name="size" attr.type="double"/>
  <key id="frequency" for="node" attr.name="frequency" attr.type="string"/>
  <key id="prognostic_importance" for="node" attr.name="prognostic_importance" attr.type="string"/>

  <!-- Edge attributes -->
  <key id="interaction_type" for="edge" attr.name="interaction_type" attr.type="string"/>
  <key id="mechanism" for="edge" attr.name="mechanism" attr.type="string"/>
  <key id="weight" for="edge" attr.name="weight" attr.type="double"/>
  <key id="edge_color" for="edge" attr.name="edge_color" attr.type="string"/>
  <key id="line_style" for="edge" attr.name="line_style" attr.type="string"/>
  <key id="clinical_relevance" for="edge" attr.name="clinical_relevance" attr.type="string"/>
  <key id="spatial_requirement" for="edge" attr.name="spatial_requirement" attr.type="string"/>

  <graph id="IO60_Network" edgedefault="directed">

    <!-- T CELL NODES -->
    <node id="CD4_Th">
      <data key="name">CD4+ Helper T cells</data>
      <data key="markers">CD3+, CD4+</data>
      <data key="cell_type">T_cell</data>
      <data key="lineage">lymphoid</data>
      <data key="color">#4472C4</data>
      <data key="size">20.0</data>
      <data key="frequency">high</data>
      <data key="prognostic_importance">high</data>
    </node>

    <node id="CD8_CTL">
      <data key="name">CD8+ Cytotoxic T cells</data>
      <data key="markers">CD3+, CD8+</data>
      <data key="cell_type">T_cell</data>
      <data key="lineage">lymphoid</data>
      <data key="color">#4472C4</data>
      <data key="size">22.0</data>
      <data key="frequency">high</data>
      <data key="prognostic_importance">very_high</data>
    </node>

    <node id="Treg">
      <data key="name">Regulatory T cells</data>
      <data key="markers">CD3+, CD4+, FOXP3+</data>
      <data key="cell_type">T_cell</data>
      <data key="lineage">lymphoid</data>
      <data key="color">#5B9BD5</data>
      <data key="size">15.0</data>
      <data key="frequency">medium</data>
      <data key="prognostic_importance">high_negative</data>
    </node>

    <node id="Tex_prog">
      <data key="name">Progenitor Exhausted T cells</data>
      <data key="markers">TCF-1+, PD-1+, TIM-3-, CXCR5+</data>
      <data key="cell_type">T_cell</data>
      <data key="lineage">lymphoid</data>
      <data key="color">#7030A0</data>
      <data key="size">16.0</data>
      <data key="frequency">medium</data>
      <data key="prognostic_importance">high_positive</data>
    </node>

    <node id="Tex_term">
      <data key="name">Terminally Exhausted T cells</data>
      <data key="markers">TOX+, PD-1high, TIM-3+, LAG-3+, CD39high</data>
      <data key="cell_type">T_cell</data>
      <data key="lineage">lymphoid</data>
      <data key="color">#3B2F5E</data>
      <data key="size">14.0</data>
      <data key="frequency">medium</data>
      <data key="prognostic_importance">negative</data>
    </node>

    <node id="Memory_T">
      <data key="name">Memory T cells</data>
      <data key="markers">CD45RO+, TCF-1+, CD127+</data>
      <data key="cell_type">T_cell</data>
      <data key="lineage">lymphoid</data>
      <data key="color">#6BA4D6</data>
      <data key="size">18.0</data>
      <data key="frequency">high</data>
      <data key="prognostic_importance">high_positive</data>
    </node>

    <node id="Tfh">
      <data key="name">Follicular Helper T cells</data>
      <data key="markers">CD4+, CXCR5+, PD-1+, ICOS+, Bcl6+</data>
      <data key="cell_type">T_cell</data>
      <data key="lineage">lymphoid</data>
      <data key="color">#4472C4</data>
      <data key="size">14.0</data>
      <data key="frequency">low</data>
      <data key="prognostic_importance">high_positive</data>
    </node>

    <!-- B CELL NODES -->
    <node id="B_cell">
      <data key="name">B cells</data>
      <data key="markers">CD20+, CD79a+, IgD+</data>
      <data key="cell_type">B_cell</data>
      <data key="lineage">lymphoid</data>
      <data key="color">#9E67E3</data>
      <data key="size">16.0</data>
      <data key="frequency">medium</data>
      <data key="prognostic_importance">high_positive</data>
    </node>

    <node id="Plasma_cell">
      <data key="name">Plasma cells</data>
      <data key="markers">CD38high, CD20low, CD138+, CD27+</data>
      <data key="cell_type">B_cell</data>
      <data key="lineage">lymphoid</data>
      <data key="color">#B591E8</data>
      <data key="size">14.0</data>
      <data key="frequency">low</data>
      <data key="prognostic_importance">high_positive</data>
    </node>

    <node id="Memory_B">
      <data key="name">Memory B cells</data>
      <data key="markers">CD20+, CD27+, IgD-, class-switched</data>
      <data key="cell_type">B_cell</data>
      <data key="lineage">lymphoid</data>
      <data key="color">#AA82E3</data>
      <data key="size">15.0</data>
      <data key="frequency">medium</data>
      <data key="prognostic_importance">positive</data>
    </node>

    <!-- NK CELL NODE -->
    <node id="NK_cell">
      <data key="name">NK cells</data>
      <data key="markers">CD56+, CD3-</data>
      <data key="cell_type">NK_cell</data>
      <data key="lineage">lymphoid</data>
      <data key="color">#E74C3C</data>
      <data key="size">17.0</data>
      <data key="frequency">medium</data>
      <data key="prognostic_importance">positive</data>
    </node>

    <!-- MYELOID NODES -->
    <node id="Dendritic_cell">
      <data key="name">Dendritic cells</data>
      <data key="markers">CD11c+, HLA-DR+, DC-LAMP+</data>
      <data key="cell_type">dendritic_cell</data>
      <data key="lineage">myeloid</data>
      <data key="color">#F39C12</data>
      <data key="size">25.0</data>
      <data key="frequency">low</data>
      <data key="prognostic_importance">very_high_positive</data>
    </node>

    <node id="M1_Macrophage">
      <data key="name">M1 Macrophages</data>
      <data key="markers">CD68+, iNOS+, CD80high, HLA-DRhigh</data>
      <data key="cell_type">macrophage</data>
      <data key="lineage">myeloid</data>
      <data key="color">#E67E22</data>
      <data key="size">20.0</data>
      <data key="frequency">medium</data>
      <data key="prognostic_importance">high_positive</data>
    </node>

    <node id="M2_Macrophage">
      <data key="name">M2 Macrophages</data>
      <data key="markers">CD68+, CD163+, CD206+, HLA-DRlow</data>
      <data key="cell_type">macrophage</data>
      <data key="lineage">myeloid</data>
      <data key="color">#D35400</data>
      <data key="size">22.0</data>
      <data key="frequency">high</data>
      <data key="prognostic_importance">high_negative</data>
    </node>

    <node id="Neutrophil">
      <data key="name">Neutrophils</data>
      <data key="markers">CD11b+, CD66+, MPO+</data>
      <data key="cell_type">neutrophil</data>
      <data key="lineage">myeloid</data>
      <data key="color">#F4A460</data>
      <data key="size">15.0</data>
      <data key="frequency">variable</data>
      <data key="prognostic_importance">context_dependent</data>
    </node>

    <node id="MDSC">
      <data key="name">Myeloid-Derived Suppressor Cells</data>
      <data key="markers">CD11b+, HLA-DRlow, CD33+</data>
      <data key="cell_type">MDSC</data>
      <data key="lineage">myeloid</data>
      <data key="color">#8B4513</data>
      <data key="size">16.0</data>
      <data key="frequency">high_in_tumors</data>
      <data key="prognostic_importance">high_negative</data>
    </node>

    <!-- STROMAL AND TUMOR NODES -->
    <node id="Tumor_cell">
      <data key="name">Tumor cells</data>
      <data key="markers">PanCK+, PD-L1+/-, MHC-I+/-</data>
      <data key="cell_type">tumor</data>
      <data key="lineage">epithelial</data>
      <data key="color">#2C3E50</data>
      <data key="size">30.0</data>
      <data key="frequency">very_high</data>
      <data key="prognostic_importance">target</data>
    </node>

    <node id="CAF">
      <data key="name">Cancer-Associated Fibroblasts</data>
      <data key="markers">SMA+, podoplanin+/-</data>
      <data key="cell_type">fibroblast</data>
      <data key="lineage">stromal</data>
      <data key="color">#95A5A6</data>
      <data key="size">18.0</data>
      <data key="frequency">high</data>
      <data key="prognostic_importance">negative</data>
    </node>

    <node id="Endothelial">
      <data key="name">Endothelial cells</data>
      <data key="markers">CD31+</data>
      <data key="cell_type">endothelial</data>
      <data key="lineage">stromal</data>
      <data key="color">#BDC3C7</data>
      <data key="size">12.0</data>
      <data key="frequency">medium</data>
      <data key="prognostic_importance">context_dependent</data>
    </node>

    <!-- CHECKPOINT INHIBITORY EDGES (RED, DOTTED) -->

    <!-- PD-1/PD-L1 Axis -->
    <edge id="e1" source="CD8_CTL" target="Tumor_cell">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">PD-1/PD-L1: SHP-2 phosphatase inhibits TCR signaling, PI3K/Akt, MAPK</data>
      <data key="weight">10.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">very_high</data>
      <data key="spatial_requirement">proximity</data>
    </edge>

    <edge id="e2" source="CD8_CTL" target="Dendritic_cell">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">PD-1/PD-L1: Regulates T cell activation on DCs</data>
      <data key="weight">7.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">high</data>
      <data key="spatial_requirement">contact</data>
    </edge>

    <edge id="e3" source="CD8_CTL" target="M2_Macrophage">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">PD-1/PD-L1: M2 macrophages express high PD-L1 to prevent effector function</data>
      <data key="weight">8.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">high</data>
      <data key="spatial_requirement">proximity</data>
    </edge>

    <edge id="e4" source="Tex_term" target="Tumor_cell">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">PD-1/PD-L1: Exhausted T cells express high PD-1</data>
      <data key="weight">9.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">very_high</data>
      <data key="spatial_requirement">tumor_core</data>
    </edge>

    <edge id="e5" source="CD4_Th" target="CD4_Th">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">PD-L1/PD-L1: Bidirectional signaling via STAT3, prevents activation</data>
      <data key="weight">5.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">medium</data>
      <data key="spatial_requirement">contact</data>
    </edge>

    <!-- CTLA-4 Axis -->
    <edge id="e6" source="CD4_Th" target="Dendritic_cell">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">CTLA-4/CD80-86: Outcompetes CD28 for binding, delivers inhibitory signals</data>
      <data key="weight">9.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">very_high</data>
      <data key="spatial_requirement">lymphoid_organs</data>
    </edge>

    <edge id="e7" source="Treg" target="Dendritic_cell">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">CTLA-4 trans-endocytosis: Physical removal of CD80/86 from DCs</data>
      <data key="weight">8.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">very_high</data>
      <data key="spatial_requirement">contact</data>
    </edge>

    <edge id="e8" source="Treg" target="M1_Macrophage">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">CTLA-4 trans-endocytosis: Removes CD80/86 from macrophages</data>
      <data key="weight">7.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">high</data>
      <data key="spatial_requirement">contact</data>
    </edge>

    <!-- LAG-3 Axis -->
    <edge id="e9" source="CD8_CTL" target="Dendritic_cell">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">LAG-3/MHC-II: Higher affinity than CD4, inhibits proliferation and cytokines</data>
      <data key="weight">7.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">high</data>
      <data key="spatial_requirement">contact</data>
    </edge>

    <edge id="e10" source="CD4_Th" target="M2_Macrophage">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">LAG-3/MHC-II: Bidirectional signaling inhibits T cell and enhances macrophage survival</data>
      <data key="weight">6.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">medium</data>
      <data key="spatial_requirement">proximity</data>
    </edge>

    <edge id="e11" source="Treg" target="Dendritic_cell">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">LAG-3/MHC-II: Enhances Treg suppression and impairs DC maturation</data>
      <data key="weight">7.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">high</data>
      <data key="spatial_requirement">contact</data>
    </edge>

    <edge id="e12" source="CD8_CTL" target="Tumor_cell">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">LAG-3/MHC-II: Some tumors express MHC-II for LAG-3 interaction</data>
      <data key="weight">5.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">medium</data>
      <data key="spatial_requirement">contact</data>
    </edge>

    <!-- VISTA Axis -->
    <edge id="e13" source="M1_Macrophage" target="CD8_CTL">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">VISTA/PSGL-1: pH-dependent, maintains T cell quiescence</data>
      <data key="weight">7.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">high</data>
      <data key="spatial_requirement">acidic_TME</data>
    </edge>

    <edge id="e14" source="M2_Macrophage" target="CD4_Th">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">VISTA/PSGL-1: Myeloid-to-T-cell inhibition, enhanced in acidic pH</data>
      <data key="weight">7.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">high</data>
      <data key="spatial_requirement">acidic_TME</data>
    </edge>

    <edge id="e15" source="Dendritic_cell" target="CD8_CTL">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">VISTA: Limits DC maturation and promotes immunosuppressive phenotypes</data>
      <data key="weight">6.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">medium</data>
      <data key="spatial_requirement">contact</data>
    </edge>

    <!-- TIM-3 Axis -->
    <edge id="e16" source="Tex_term" target="MDSC">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">TIM-3/Galectin-9: Triggers calcium influx and T cell apoptosis</data>
      <data key="weight">8.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">very_high</data>
      <data key="spatial_requirement">proximity</data>
    </edge>

    <edge id="e17" source="Tex_term" target="M2_Macrophage">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">TIM-3/Galectin-9: M2 macrophages produce Galectin-9</data>
      <data key="weight">7.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">high</data>
      <data key="spatial_requirement">proximity</data>
    </edge>

    <!-- TIGIT Axis -->
    <edge id="e18" source="CD8_CTL" target="Dendritic_cell">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">TIGIT/CD155: Promotes IL-10, decreases IL-12 from DCs</data>
      <data key="weight">7.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">high</data>
      <data key="spatial_requirement">contact</data>
    </edge>

    <edge id="e19" source="NK_cell" target="Tumor_cell">
      <data key="interaction_type">checkpoint_inhibitory</data>
      <data key="mechanism">TIGIT/CD155: Competes with CD226, inhibits NK cell activation</data>
      <data key="weight">6.0</data>
      <data key="edge_color">#E74C3C</data>
      <data key="line_style">dotted</data>
      <data key="clinical_relevance">medium</data>
      <data key="spatial_requirement">contact</data>
    </edge>

    <!-- CO-STIMULATORY ACTIVATING EDGES (GREEN, SOLID) -->

    <!-- CD28/CD80-86 Axis -->
    <edge id="e20" source="CD4_Th" target="Dendritic_cell">
      <data key="interaction_type">co_stimulatory</data>
      <data key="mechanism">CD28/CD80-86: Signal 2, activates PI3K/Akt, enhances IL-2, prevents anergy</data>
      <data key="weight">10.0</data>
      <data key="edge_color">#27AE60</data>
      <data key="line_style">solid</data>
      <data key="clinical_relevance">very_high</data>
      <data key="spatial_requirement">contact</data>
    </edge>

    <edge id="e21" source="CD8_CTL" target="Dendritic_cell">
      <data key="interaction_type">co_stimulatory</data>
      <data key="mechanism">CD28/CD80-86: Essential for CD8+ T cell priming</data>
      <data key="weight">10.0</data>
      <data key="edge_color">#27AE60</data>
      <data key="line_style">solid</data>
      <data key="clinical_relevance">very_high</data>
      <data key="spatial_requirement">contact</data>
    </edge>

    <edge id="e22" source="CD4_Th" target="M1_Macrophage">
      <data key="interaction_type">co_stimulatory</data>
      <data key="mechanism">CD28/CD80-86: Macrophages can provide co-stimulation</data>
      <data key="weight">7.0</data>
      <data key="edge_color">#27AE60</data>
      <data key="line_style">solid</data>
      <data key="clinical_relevance">medium</data>
      <data key="spatial_requirement">contact</data>
    </edge>

    <!-- ICOS/ICOS-L Axis -->
    <edge id="e23" source="Tfh" target="B_cell">
      <data key="interaction_type">co_stimulatory</data>
      <data key="mechanism">ICOS/ICOS-L: Essential for germinal center formation and B cell activation</data>
      <data key="weight">9.0</data>
      <data key="edge_color">#27AE60</data>
      <data key="line_style">solid</data>
      <data key="clinical_relevance">very_high</data>
      <data key="spatial_requirement">germinal_center</data>
    </edge>

    <edge id="e24" source="CD4_Th" target="Dendritic_cell">
      <data key="interaction_type">co_stimulatory</data>
      <data key="mechanism">ICOS/ICOS-L: Activates PI3K/Akt, critical for anti-CTLA-4 efficacy</data>
      <data key="weight">8.0</data>
      <data key="edge_color">#27AE60</data>
      <data key="line_style">solid</data>
      <data key="clinical_relevance">very_high</data>
      <data key="spatial_requirement">contact</data>
    </edge>

    <edge id="e25" source="CD8_CTL" target="M1_Macrophage">
      <data key="interaction_type">co_stimulatory</data>
      <data key="mechanism">ICOS/ICOS-L: Promotes memory CD8+ formation and reduces exhaustion</data>
      <data key="weight">7.0</data>
      <data key="edge_color">#27AE60</data>
      <data key="line_style">solid</data>
      <data key="clinical_relevance">high</data>
      <data key="spatial_requirement">contact</data>
    </edge>

    <!-- OX40/OX40L Axis -->
    <edge id="e26" source="CD4_Th" target="Dendritic_cell">
      <data key="interaction_type">co_stimulatory</data>
      <data key="mechanism">OX40/OX40L: Sustained activation, memory formation, prevents apoptosis</data>
      <data key="weight">8.0</data>
      <data key="edge_color">#27AE60</data>
      <data key="line_style">solid</data>
      <data key="clinical_relevance">high</data>
      <data key="spatial_requirement">contact</data>
    </edge>

    <edge id="e27" source="CD8_CTL" target="Dendritic_cell">
      <data key="interaction_type">co_stimulatory</data>
